{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "../..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": [],
    "verbatimModuleSyntax": true,
    "paths": {
      "@kozane/core": ["./src/index.ts"],
      "@kozane/core/database": ["./src/database.ts"],
      "@kozane/core/schema": ["./src/schema.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
