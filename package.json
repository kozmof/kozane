{
  "name": "kozane-workspace",
  "private": true,
  "license": "MIT",
  "author": "Kozo Oeda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozmof/kozane.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:client && pnpm --filter kozane dev",
    "build": "pnpm build:client && node scripts/clean.mjs && pnpm --filter kozane build:app",
    "build:config-editor": "pnpm build:client && pnpm --filter kozane build:config-editor",
    "build:cli": "pnpm build:client && pnpm --filter kozane build:cli",
    "cli": "pnpm build:client && tsx packages/kozane/src/cli/index.ts",
    "preview": "pnpm --filter kozane preview",
    "prepare": "pnpm build:client && pnpm --filter kozane prepare:app && panda codegen --silent",
    "check": "pnpm build:client && pnpm --filter kozane check",
    "check:watch": "pnpm build:client && pnpm --filter kozane check:watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --threads=1",
    "fmt:check": "oxfmt --check --threads=1",
    "test": "pnpm build:client && TMPDIR=/tmp vitest --config vitest.source.config.ts run",
    "test:watch": "pnpm build:client && TMPDIR=/tmp vitest --config vitest.source.config.ts",
    "test:coverage": "pnpm build:client && TMPDIR=/tmp vitest --config vitest.source.config.ts run --coverage",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "pack:tmp": "TMPDIR=/tmp pnpm --filter kozane pack --pack-destination /tmp",
    "pack:check": "pnpm pack:tmp && pnpm pack:check-compare && pnpm pack:check-built && pnpm pack:check-entry",
    "pack:check-entry": "TMPDIR=/tmp node scripts/check-package-entry.mjs",
    "pack:check-name": "node -p \"'kozane-'+require('./packages/kozane/package.json').version\"",
    "pack:check-counts": "name=$(pnpm run --silent pack:check-name) && tar -tzf /tmp/$name.tgz | grep -E '^package/(bin|drizzle)/.' | wc -l | tr -d ' '",
    "pack:check-list": "name=$(pnpm run --silent pack:check-name) && tar -tzf /tmp/$name.tgz | sort",
    "pack:check-compare": "counts=$(pnpm run --silent pack:check-counts) && expected=$(find packages/kozane/bin packages/kozane/drizzle -type f | wc -l | tr -d ' ') && if [ \"$counts\" -ne \"$expected\" ]; then echo \"ERROR: expected $expected files under bin/ and drizzle/ in tgz, got $counts. Listing:\"; pnpm run --silent pack:check-list; exit 1; else echo OK; fi",
    "pack:check-built": "name=$(pnpm run --silent pack:check-name) && for dir in dist build; do n=$(tar -tzf /tmp/$name.tgz | grep -cE \"^package/$dir/.\" || true); if [ \"$n\" -eq 0 ]; then echo \"ERROR: $dir/ is empty in the tarball\"; pnpm run --silent pack:check-list; exit 1; fi; echo \"$dir/: $n files\"; done",
    "preflight": "pnpm release:local",
    "pre-release-check": "pnpm release:local",
    "clean": "node scripts/clean.mjs",
    "verify": "node scripts/verify-workspace.mjs",
    "test:e2e": "TMPDIR=/tmp playwright test",
    "verify:production": "pnpm verify && pnpm audit:production && pnpm smoke:package && pnpm test:e2e",
    "check:client-browser": "node scripts/check-client-browser.mjs",
    "check:core-browser": "node scripts/check-core-browser.mjs",
    "check:client-contract": "node scripts/check-client-contract.mjs",
    "smoke:ssg": "node scripts/smoke-ssg.mjs",
    "build:core": "pnpm --filter @kozane/core build",
    "check:core-package": "node scripts/check-core-package.mjs",
    "build:restoration-harness": "node scripts/check-core-package.mjs --restoration-harness",
    "test:restoration-harness": "pnpm build:restoration-harness && playwright test --config scripts/restoration-harness/playwright.config.ts",
    "check:compatibility-retention": "node scripts/compatibility/check-retention.mjs",
    "release:check:core": "pnpm test:client-package && pnpm test:restoration-harness",
    "build:client": "pnpm --filter @kozane/core build && pnpm --filter @kozane/client build",
    "check:client-package": "node scripts/check-core-package.mjs --client-package",
    "build:client-harness": "node scripts/check-core-package.mjs --client-package --client-browser-harness",
    "test:client-package": "pnpm build:client-harness && playwright test --config scripts/client-package/playwright.config.ts",
    "release:check:client": "pnpm test:client-package && pnpm test:restoration-harness",
    "check:node-core": "pnpm build:cli && node scripts/check-node-core.mjs",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && node scripts/check-release-packages.mjs",
    "release:check": "node scripts/check-release-packages.mjs && node scripts/check-release-versioning.mjs && node --test scripts/release-registry.test.mjs && node --test scripts/release-artifacts.test.mjs && node --test scripts/verification-plan.test.mjs scripts/migration-build.test.mjs && node --test scripts/auto-release.test.mjs",
    "smoke:package:install": "node scripts/smoke-package.mjs --install-only",
    "release:verify:registry": "node scripts/check-registry-release.mjs && node scripts/smoke-package.mjs --registry",
    "test:db-wasm": "vitest run --config scripts/database-parity/vitest.config.ts",
    "test:db-browser": "KOZANE_DB_BROWSER=1 vitest run --config scripts/database-parity/vitest.config.ts",
    "release:local": "node scripts/local-release.mjs prepare",
    "release:publish": "node scripts/local-release.mjs publish",
    "db:generate": "pnpm --filter kozane db:generate && pnpm --filter @kozane/core migrations:refresh",
    "test:coverage:source": "UV_THREADPOOL_SIZE=1 TOKIO_WORKER_THREADS=1 TMPDIR=/tmp vitest run --config vitest.source.config.ts --maxWorkers=2 --coverage",
    "test:packages": "node scripts/check-core-package.mjs --client-package",
    "check:app-imports": "node scripts/check-app-package-imports.mjs",
    "build:packages": "node scripts/pack-workspace.mjs",
    "release:auto": "node scripts/auto-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@kozane/client": "workspace:0.1.4",
    "@kozane/core": "workspace:0.1.1",
    "@kozmof/reed": "^4.1.0",
    "@libsql/client": "^0.17.4",
    "@pandacss/dev": "^1.12.1",
    "@playwright/test": "^1.64.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.88.0",
    "svelte": "5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2",
      "nanoid@<3.3.17": ">=3.3.17"
    }
  }
}
