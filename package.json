{
  "name": "kozane",
  "version": "0.3.0",
  "license": "MIT",
  "author": "Kozo Oeda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozmof/kozane.git"
  },
  "bin": {
    "kozane": "./bin/kozane.js"
  },
  "files": [
    "bin",
    "dist",
    "build",
    "drizzle"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/clean.mjs && drizzle-kit generate && vite build && tsc --project tsconfig.cli.json",
    "build:cli": "tsc --project tsconfig.cli.json",
    "cli": "tsx src/cli/index.ts",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync || echo '') && panda codegen --silent",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --threads=1",
    "fmt:check": "oxfmt --check --threads=1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "pack:tmp": "TMPDIR=/tmp pnpm pack --pack-destination /tmp",
    "pack:check": "pnpm pack:tmp && pnpm pack:check-compare",
    "pack:check-name": "v=$(echo $npm_package_version) && name='kozane-'$v && echo $name",
    "pack:check-counts": "name=$(pnpm run --silent pack:check-name) && echo $(tar -tzf /tmp/$name.tgz | wc -l)",
    "pack:check-list": "name=$(pnpm run --silent pack:check-name) && tar -tzf /tmp/$name.tgz | sort",
    "pack:check-compare": "counts=$(pnpm run --silent pack:check-counts) && if [ $counts -ne 328 ]; then echo \"ERROR: expected 328 files in tgz, got $counts. Listing:\"; pnpm run --silent pack:check-list; exit 1; else echo OK; fi",
    "preflight": "TMPDIR=/tmp npm_config_cache=/tmp/kozane-npm-cache pnpm publish --dry-run",
    "pre-release-check": "pnpm preflight && pnpm pack:check",
    "clean": "node scripts/clean.mjs",
    "verify": "pnpm check && pnpm lint && pnpm fmt:check && pnpm test:coverage && pnpm build",
    "prepack": "pnpm build",
    "test:e2e": "playwright test",
    "verify:production": "pnpm verify && pnpm audit:production && pnpm smoke:package && pnpm test:e2e"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.5",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.75.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2"
    }
  }
}
